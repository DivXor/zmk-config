/* Combo set shared by all keymap variants (flo / sen / cal).
 *
 * Requires these macros to be defined by the keymap BEFORE this include:
 *   BASE            — base layer index
 *   KEYS_* position labels via zmk-helpers (LT0.. LB5, RM1, RB0.. etc.)
 *   &caps_word_kebab (behaviours_variants.dtsi)
 *
 * Gestures are position-based (inner-indexed zmk-helpers labels), so they
 * land on the same physical letters on both the totem (5-col + wings) and
 * the kometa (6-col). Mirrors config/includes/combos.dtsi plus:
 *   N+M   -> Backspace (no dedicated BSPC key in sen/cal base)
 *   , + . -> Key repeat (double symbols: == ++ // **, per getreuer)
 *
 * KEY POSITIONS (both boards)
 * ┌──────────────────────────┬──────────────────────────┐
 * │       LT4 LT3 LT2 LT1 LT0│RT0 RT1 RT2 RT3 RT4       │
 * │       LM4 LM3 LM2 LM1 LM0│RM0 RM1 RM2 RM3 RM4       │
 * │LB5 LB4 LB3 LB2 LB1 LB0   │  RB0 RB1 RB2 RB3 RB4 RB5 │
 * └──────────╮ LH2 LH1 LH0  │  RH0 RH1 RH2 ╭────────────┘
 *            ╰──────────────┴──────────────╯       */

#define COMBO(NAME, BINDINGS, KEYPOS, LAYERS, TERM, QUICKTAP, ...) \
  combo_##NAME { \
      timeout-ms = <TERM>; \
      bindings = <BINDINGS>; \
      key-positions = <KEYPOS>; \
      layers = <LAYERS>; \
      require-prior-idle-ms = <QUICKTAP>; \
      __VA_ARGS__ \
  };

/{
  combos {
    compatible = "zmk,combos";

    COMBO(escape_left,       &kp ESC,            LT4 LT3,         BASE, 40, 200, slow-release;)
    COMBO(escape,            &kp ESC,            RM1 RM2,         BASE, 40, 0)
    COMBO(delete,            &kp DELETE,         LM2 LM1,         BASE, 40, 100)
    COMBO(enter,             &kp ENTER,          LM4 LM3 LM2,     BASE, 40, 220, slow-release;)
    COMBO(caps_word,         &caps_word_kebab,   LM2 LM1 RM1 RM2, BASE, 50, 0)
    COMBO(copy,              &kp LG(C),          LB3 LB2,         BASE, 50, 120)
    COMBO(paste,             &kp LG(V),          LB2 LB1,         BASE, 50, 120)
    COMBO(cut,               &kp LG(X),          LB3 LB1,         BASE, 40, 120)
    COMBO(bspc,              &kp BSPC,           RB0 RB1,         BASE, 50, 150)
    COMBO(repeat,            &key_repeat,        RB2 RB3,         BASE, 40, 0)
  };
};