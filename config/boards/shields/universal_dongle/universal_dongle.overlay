/*
 * Universal dongle: keyless central for the XIAO BLE dongle hardware.
 *
 * One firmware for all three keyboards. The keymap (universal_dongle.keymap)
 * carries two configurations and is switched at runtime with the Z+X combo:
 *
 *   layers 0-3  Totem config        (totem-native 38 positions)
 *   layers 4-7  Corne/Kometa config (shared 42 positions)
 *
 * Drives totem, corne, and kometa halves flashed in peripheral mode.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &universal_dongle_kscan;
        // The transform sizes ZMK_KEYMAP_LEN — ZMK's per-position runtime
        // state (keymap.c, hold-taps, combos, macros). Without it ZMK falls
        // back to the mock kscan's 0x0 matrix, sizing those arrays to zero;
        // every position event from the halves would then write far out of
        // bounds and corrupt the firmware. 42 = union of totem (0-37) and
        // corne/kometa (0-41) positions; the map itself is never consulted
        // because the mock kscan emits no matrix events.
        zmk,matrix-transform = &universal_dongle_transform;
    };

    universal_dongle_kscan: kscan_1 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    universal_dongle_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <42>;
        rows = <1>;

        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)
            RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(0,14) RC(0,15) RC(0,16) RC(0,17) RC(0,18) RC(0,19) RC(0,20)
            RC(0,21) RC(0,22) RC(0,23) RC(0,24) RC(0,25) RC(0,26) RC(0,27)
            RC(0,28) RC(0,29) RC(0,30) RC(0,31) RC(0,32) RC(0,33) RC(0,34)
            RC(0,35) RC(0,36) RC(0,37) RC(0,38) RC(0,39) RC(0,40) RC(0,41)
        >;
    };
};