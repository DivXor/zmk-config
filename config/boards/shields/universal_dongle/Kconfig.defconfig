# SPDX-License-Identifier: MIT

if SHIELD_UNIVERSAL_DONGLE

# Max 16 characters in keyboard name
config ZMK_KEYBOARD_NAME
    default "UNIVERSAL DONGLE"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Bond all six halves: totem L/R + corne L/R + kometa L/R; whichever pair is
# powered on will connect to the central.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 6

# ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS (6) + 2 spare BT host profiles
# (also set in universal_dongle.conf; the assignment there is deterministic)
config BT_MAX_CONN
    default 8

config BT_MAX_PAIRED
    default 8

endif