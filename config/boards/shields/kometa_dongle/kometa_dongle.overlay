/*
 * Kometa dongle: keyless central for the XIAO BLE dongle hardware.
 *
 * Dedicated firmware running config/kometa.keymap (the `kometa_dongle`
 * shield name resolves to the `kometa` config candidates). Drives kometa
 * halves flashed in peripheral mode (CONFIG_ZMK_SPLIT_ROLE_CENTRAL=n,
 * the `kometa-dongle-left/right` artifacts).
 *
 * The physical layout inventory mirrors the corne halves exactly (same
 * layout nodes, same order, same transform maps), because the central
 * pushes its selected layout *index* to every connected half and each
 * half resolves that index against its own layout list. Kometa halves
 * have a single 42-key layout: they reject the pushed index and keep
 * their own. Corne halves would resolve index 1 to the 6-column layout
 * — the same one this dongle selects — so they would work too if ever
 * bonded (with kometa bindings).
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <layouts/foostan/corne/5column.dtsi>
#include <layouts/foostan/corne/6column.dtsi>

&foostan_corne_5col_layout {
    transform = <&kometa_dongle_five_col_transform>;
};

&foostan_corne_6col_layout {
    transform = <&kometa_dongle_transform>;
};

/ {
    chosen {
        zmk,kscan = &kometa_dongle_kscan;
        zmk,physical-layout = &foostan_corne_6col_layout;
    };

    kometa_dongle_kscan: kscan_1 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    // Transform maps copied verbatim from the corne shield (corne.dtsi).
    // The dongle's own (mock) kscan never feeds them, but layout-switch
    // position mapping must stay consistent with the halves.
    kometa_dongle_transform: dongle_transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;

        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };

    kometa_dongle_five_col_transform: dongle_five_col_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;

        map = <
RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };
};