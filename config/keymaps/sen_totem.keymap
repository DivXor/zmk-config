/*
 * Variant B — "seniply-core" (sticky one-shot mods, pure thumb holds)
 *
 * Design lineage: Seniply (stevep99) + urob's nav layer. Zero tap/hold
 * decisions on thumbs (all six are pure holds or plain keys) and the only
 * dual-role keys anywhere are the homerow mods themselves.
 *
 * Mods:    one-shot (&sk) modifiers on each layer's free home row, at the
 *          same positions as the homerow mods. Tap Ctrl, tap Shift+Alt
 *          (sticky hyper at G), then the key — sequential but race-free.
 *          IntelliJ chords: sticky hyper tap + key, or stack one-shots.
 * ESC/BSPC: no dedicated keys — Q+W / J+K combos (ESC), N+M (BSPC),
 *          D+F (DEL), plus BSPC/DEL/INS on the EXT layer.
 * SYS:     hold EXT + SYM together.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/totem.h"

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4 RB5
#define KEYS_T LH2 LH1 LH0 RH0 RH1 RH2

#include "../includes/behaviours_homerow_mods.dtsi"
#include "../includes/behaviours_variants.dtsi"

#define BASE 0
#define EXT  1
#define NUM  2
#define SYM  3
#define FUN  4
#define SYS  5

#include "../includes/combos_variants.dtsi"

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <EXT SYM>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //             ┌────┬────┬────┬────┬────┐        ┌────┬────┬────┬────┬────┐
        //             │ Q  │ W  │ E  │ R  │ T  │        │ Y  │ U  │ I  │ O  │ P  │
        //             ├────┼────┼────┼────┼────┤        ├────┼────┼────┼────┼────┤
        //             │ A* │ S* │ D* │ F* │ G  │        │ H  │ J* │ K* │ L* │ ;* │
        //        ┌────┼────┼────┼────┼────┼────┐        ├────┼────┼────┼────┼────┼────┐
        //        │TAB │ Z  │ X  │ C  │ V  │ B  │        │ N  │ M  │ ,  │ .  │ /  │'⌘  │
        //        └────┴────┴────┴────┼────┼────┼────┐┌───┼────┼────┼────┼────┼────┴────┘
        //                           │EXT │NUM │ RET ││SPC │SYM │FUN │
        //                           └────┴────┴─────┘└────┴────┴────┘

        base_layer {
            display-name = "Base";
            label = "BASE";

            bindings = <
                &kp Q                 &kp W                &kp E                &kp R               &kp T                        &kp Y       &kp U                &kp I               &kp O                 &kp P
                &hm_shift_l LSHFT A   &hm_l LCTRL S        &hm_l LALT D         &hm_l LGUI F        &kp G                        &kp H       &hm_r RGUI J          &hm_r RALT K        &hm_r RCTRL L         &hm_shift_r RSHFT SEMICOLON
                &kp TAB               &kp Z                &kp X                &kp C               &kp V        &kp B            &kp N       &kp M                &kp COMMA            &kp DOT               &kp SLASH                    &sqt_hyper LC(LS(LA(LGUI))) SQT
                                            &mo EXT   &mo NUM   &kp RET     &kp SPACE    &mo SYM   &mo FUN
            >;
        };

        // One-shot mods on the left home row (position-matched to HRM);
        // sticky hyper at G; nav + BSPC/DEL/INS on the right.
        //             ┌────┬────┬────┬────┬────┐        ┌─────┬─────┬─────┬─────┬─────┐
        //             │    │    │    │    │    │        │PGUP │BSPC │ DEL │ INS │     │
        //             ├────┼────┼────┼────┼────┤        ├─────┼─────┼─────┼─────┼─────┤
        //             │⇧→ │⌃→ │⌥→ │⌘→ │HYP→│        │ ←   │ ↓   │ ↑   │ →   │CAPS │
        //        ┌────┼────┼────┼────┼────┼────┐        ├─────┼─────┼─────┼─────┼─────┼─────┐
        //        │    │    │    │    │    │    │        │     │HOME │END  │     │     │     │
        //        └────┴────┴────┴────┼────┼────┼────┐┌───┼─────┼─────┼─────┼─────┴─────┴─────┘
        //                           │    │    │    ││    │     │     │
        //                           └────┴────┴─────┘└────┴─────┴─────┘
        // → = one-shot (sticky) mod: tap, release, then the key

        ext_layer {
            display-name = "Extend";
            label = "EXT";

            bindings = <
                &trans  &trans  &trans  &trans  &trans                    &kp PG_UP    &kp BSPC      &kp DEL     &kp INS     &trans
                &sk LSHFT  &sk LCTRL  &sk LALT  &sk LGUI  &sk LC(LS(LA(LGUI)))  &kp LEFT     &kp DOWN      &kp UP      &kp RIGHT   &caps_word_kebab
                &trans  &trans  &trans  &trans  &trans  &trans             &trans       &kp HOME      &kp END     &trans      &trans      &trans
                                            &trans  &trans  &trans      &trans    &trans      &trans
            >;
        };

        // Calculator-style numpad on the right (miryoku rule: left thumb
        // holds the layer, right hand works); one-shot mods on the left.
        //             ┌────┬────┬────┬────┬────┐        ┌────┬────┬────┬────┬────┐
        //             │    │    │    │    │    │        │ -  │ 7  │ 8  │ 9  │ /  │
        //             ├────┼────┼────┼────┼────┤        ├────┼────┼────┼────┼────┤
        //             │⇧→ │⌃→ │⌥→ │⌘→ │HYP→│        │ +  │ 4  │ 5  │ 6  │ *  │
        //        ┌────┼────┼────┼────┼────┼────┐        ├────┼────┼────┼────┼────┼────┐
        //        │    │    │    │    │    │    │        │ .  │ 1  │ 2  │ 3  │ 0  │ =  │
        //        └────┴────┴────┴────┼────┼────┼────┐┌───┼────┼────┼────┼────┼────┴────┘
        //                           │    │    │    ││    │    │    │
        //                           └────┴────┴─────┘└────┴────┴────┘
        num_layer {
            display-name = "Num";
            label = "NUM";

            bindings = <
                &trans  &trans  &trans  &trans  &trans                    &kp MINUS   &kp N7      &kp N8      &kp N9      &kp SLASH
                &sk LSHFT  &sk LCTRL  &sk LALT  &sk LGUI  &sk LC(LS(LA(LGUI)))  &kp PLUS    &kp N4      &kp N5      &kp N6      &kp ASTRK
                &trans  &trans  &trans  &trans  &trans  &trans             &kp DOT     &kp N1      &kp N2      &kp N3      &kp N0     &kp EQUAL
                                            &trans  &trans  &trans      &trans    &trans      &trans
            >;
        };

        // Symbols on the left (shifted-number-row mnemonics top, brackets
        // bottom, frequent _ ( ) = : on home); one-shot mods right home row.
        //             ┌────┬────┬────┬────┬────┐        ┌────┬────┬────┬────┬────┐
        //             │ !  │ @  │ #  │ $  │ %  │        │ ^  │ &  │ *  │ \  │ |  │
        //             ├────┼────┼────┼────┼────┤        ├────┼────┼────┼────┼────┤
        //             │ _  │ (  │ )  │ =  │ :  │        │    │⌘→ │⌥→ │⌃→ │⇧→ │
        //        ┌────┼────┼────┼────┼────┼────┐        ├────┼────┼────┼────┼────┼────┐
        //        │    │ [  │ ]  │ {  │ }  │ -  │        │ `  │ ~  │    │    │    │    │
        //        └────┴────┴────┴────┼────┼────┼────┐┌───┼────┼────┼────┼────┼────┴────┘
        //                           │    │    │    ││    │    │    │
        //                           └────┴────┴─────┘└────┴────┴────┘
        sym_layer {
            display-name = "Sym";
            label = "SYM";

            bindings = <
                &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT              &kp CARET   &kp AMPS    &kp ASTRK   &kp BSLH    &kp PIPE
                &kp UNDER  &kp LPAR   &kp RPAR   &kp EQUAL  &kp COLON              &trans      &sk RGUI    &sk RALT    &sk RCTRL   &sk RSHFT
                &trans     &kp LBKT   &kp RBKT   &kp LBRC   &kp RBRC   &kp MINUS    &kp GRAVE   &kp TILDE   &trans      &trans      &trans      &trans
                                            &trans  &trans  &trans      &trans    &trans      &trans
            >;
        };

        // F-keys left, media right — same layout as the flo variant's FUN.
        fun_layer {
            display-name = "Fun";
            label = "FUN";

            bindings = <
                &kp F12   &kp F7   &kp F8   &kp F9   &kp PSCRN              &kp C_BRI_DEC    &kp C_BRI_INC   &trans    &trans    &trans
                &kp F11   &kp F4   &kp F5   &kp F6   &trans                 &kp C_PREV       &kp C_VOL_DN   &kp C_VOL_UP  &kp C_NEXT   &kp C_MUTE
                &trans    &kp F10  &kp F1   &kp F2   &kp F3     &trans      &kp C_PP         &region_capture2  &trans   &trans    &trans    &trans
                                            &trans  &trans  &trans      &trans    &trans    &trans
            >;
        };

        // Hold EXT + SYM together: BT / outputs / reset / studio.
        sys_layer {
            display-name = "Sys";
            label = "SYS";

            bindings = <
                &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4          &out OUT_BLE     &out OUT_USB     &out OUT_TOG     &trans    &trans
                &trans          &trans          &trans          &trans          &bt BT_CLR           &trans           &trans           &trans           &trans    &trans
                &trans          &sys_reset      &bootloader     &studio_unlock  &trans          &trans &trans           &trans           &trans           &trans    &trans    &trans
                                                &trans          &trans          &trans                 &trans           &trans           &trans
            >;
        };
    };
};