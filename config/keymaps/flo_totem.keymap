/*
 * Variant A — "flo-core" (layer-tap thumbs, real mods on the free hand)
 *
 * Design lineage: Florian Gächter's Totem layout (flo.gaechter.xyz), adapted
 * to this repo's QWERTY base, positional homerow mods and thumb arrangement
 * (RET left-inner, SPC right-inner). See docs/split-keymap-research.md.
 *
 * Thumbs:  every thumb is a layer-tap or plain key; five momentary layers
 *          (NAV / SYM / NUM / FUN) + SYS tri-layer (hold NUM + SYM).
 * Mods:    each layer carries REAL modifiers on the free hand's home row,
 *          at the same positions as the homerow mods (A=Shift S=Ctrl D=Alt
 *          F=Gui | J=Gui K=Alt L=Ctrl ;=Shift). They chord instantly —
 *          no tap/hold timing — which is the fix for IntelliJ multi-mod
 *          combos (hold NAV, press Ctrl+Shift+Alt together, press key).
 * Wings:   TAB (left), ' / Hyper-hold (right).
 * Combos:  shared set incl. ESC (Q+W / J+K), BSPC (N+M), key repeat (,+.)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/totem.h"

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4 RB5
#define KEYS_T LH2 LH1 LH0 RH0 RH1 RH2

#include "../includes/behaviours_homerow_mods.dtsi"
#include "../includes/behaviours_variants.dtsi"

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define FUN  4
#define SYS  5

#include "../includes/combos_variants.dtsi"

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NUM SYM>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //             ┌────┬────┬────┬────┬────┐        ┌────┬────┬────┬────┬────┐
        //             │ Q  │ W  │ E  │ R  │ T  │        │ Y  │ U  │ I  │ O  │ P  │
        //             ├────┼────┼────┼────┼────┤        ├────┼────┼────┼────┼────┤
        //             │ A* │ S* │ D* │ F* │ G  │        │ H  │ J* │ K* │ L* │ ;* │
        //        ┌────┼────┼────┼────┼────┼────┤        ├────┼────┼────┼────┼────┼────┐
        //        │TAB │ Z  │ X  │ C  │ V  │ B  │        │ N  │ M  │ ,  │ .  │ /  │'⌘  │
        //        └────┴────┴────┴────┼────┼────┼────┐┌───┼────┼────┼────┼────┼────┴────┘
        //                           │ESC │SYM │ RET ││SPC │NUM │BSPC│
        //                           └────┴────┴─────┘└────┴────┴────┘
        // * hold for mods (Shift/Ctrl/Alt/Gui — mirrored both sides)

        base_layer {
            display-name = "Base";
            label = "BASE";

            bindings = <
                &kp Q                 &kp W                &kp E                &kp R               &kp T                        &kp Y       &kp U                &kp I               &kp O                 &kp P
                &hm_shift_l LSHFT A   &hm_l LCTRL S        &hm_l LALT D         &hm_l LGUI F        &kp G                        &kp H       &hm_r RGUI J          &hm_r RALT K        &hm_r RCTRL L         &hm_shift_r RSHFT SEMICOLON
                &kp TAB               &kp Z                &kp X                &kp C               &kp V        &kp B            &kp N       &kp M                &kp COMMA            &kp DOT               &kp SLASH                    &sqt_hyper
                                                             &lt_esc_fun FUN ESC    &mo SYM            &kp RET     &lt_spc_nav NAV SPACE    &mo NUM    &lt_bspc_fun FUN BSPC
            >;
        };

        // Real mods on the left home row; nav + clipboard on the right.
        //             ┌────┬────┬────┬────┬────┐        ┌─────┬─────┬─────┬─────┬─────┐
        //             │    │    │    │    │    │        │UNDO │CUT  │COPY │PASTE│REDO │
        //             ├────┼────┼────┼────┼────┤        ├─────┼─────┼─────┼─────┼─────┤
        //             │⇧   │⌃   │⌥   │⌘   │    │        │ ←   │ ↓   │ ↑   │ →   │CAPS │
        //        ┌────┼────┼────┼────┼────┼────┐        ├─────┼─────┼─────┼─────┼─────┼─────┐
        //        │    │    │    │    │    │    │        │ INS │PGDN │PGUP │HOME │END  │     │
        //        └────┴────┴────┴────┼────┼────┼────┐┌────┼─────┼─────┼─────┼─────┴─────┴─────┘
        //                           │    │    │    ││    │     │     │
        //                           └────┴────┴─────┘└────┴─────┴─────┘
        nav_layer {
            display-name = "Nav";
            label = "NAV";

            bindings = <
                &trans  &trans  &trans  &trans  &trans                    &kp LG(Z)      &kp LG(X)      &kp LG(C)      &kp LG(V)          &kp LS(LG(Z))
                &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans          &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT           &caps_word_kebab
                &trans  &trans  &trans  &trans  &trans  &trans             &kp INS        &kp PG_DN      &kp PG_UP      &kp HOME            &kp END            &trans
                                              &trans  &trans  &trans      &trans         &trans         &trans
            >;
        };

        // Symbols on the right (flo arrangement); real mods on the left home
        // row; '_' on the quote-wing.
        //             ┌────┬────┬────┬────┬────┐        ┌────┬────┬────┬────┬────┐
        //             │    │    │    │    │    │        │ {  │ &  │ *  │ (  │ }  │
        //             ├────┼────┼────┼────┼────┤        ├────┼────┼────┼────┼────┤
        //             │⇧   │⌃   │⌥   │⌘   │    │        │ :  │ $  │ %  │ ^  │ +  │
        //        ┌────┼────┼────┼────┼────┼────┐        ├────┼────┼────┼────┼────┼────┐
        //        │    │    │    │    │    │    │        │ ~  │ !  │ @  │ #  │ |  │ _  │
        //        └────┴────┴────┴────┼────┼────┼────┐┌───┼────┼────┼────┼────┼────┴────┘
        //                           │    │    │    ││    │    │    │
        //                           └────┴────┴─────┘└────┴────┴────┘
        sym_layer {
            display-name = "Sym";
            label = "SYM";

            bindings = <
                &trans  &trans  &trans  &trans  &trans                    &kp LBRC      &kp AMPS     &kp ASTRK     &kp LPAR      &kp RBRC
                &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans          &kp COLON     &kp DLLR     &kp PRCNT     &kp CARET     &kp PLUS
                &trans  &trans  &trans  &trans  &trans  &trans            &kp TILDE     &kp EXCL     &kp AT        &kp HASH      &kp PIPE         &kp UNDER
                                              &trans  &trans  &trans      &trans        &trans       &trans
            >;
        };

        // Calculator-style numpad on the left (top-row digits, no KP_* codes);
        // real mods on the right home row — hold NUM + right Shift for
        // shifted digits (&, %, ...) straight from the numpad.
        //             ┌────┬────┬────┬────┬────┐        ┌────┬────┬────┬────┬────┐
        //             │ -  │ 7  │ 8  │ 9  │ /  │        │    │    │    │    │    │
        //             ├────┼────┼────┼────┼────┤        ├────┼────┼────┼────┼────┤
        //             │ +  │ 4  │ 5  │ 6  │ *  │        │    │⌘   │⌥   │⌃   │⇧   │
        //        ┌────┼────┼────┼────┼────┼────┐        ├────┼────┼────┼────┼────┼────┐
        //        │ .  │ 1  │ 2  │ 3  │ 0  │ =  │        │    │    │    │    │    │    │
        //        └────┴────┴────┴────┼────┼────┼────┐┌───┼────┼────┼────┼────┼────┴────┘
        //                           │    │    │    ││    │    │    │
        //                           └────┴────┴─────┘└────┴────┴────┘
        num_layer {
            display-name = "Num";
            label = "NUM";

            bindings = <
                &kp MINUS   &kp N7   &kp N8   &kp N9   &kp SLASH              &trans    &trans      &trans      &trans      &trans
                &kp PLUS    &kp N4   &kp N5   &kp N6   &kp ASTRK              &trans    &kp RGUI    &kp RALT    &kp RCTRL   &kp RSHFT
                &kp DOT     &kp N1   &kp N2   &kp N3   &kp N0     &kp EQUAL   &trans    &trans      &trans      &trans      &trans      &trans
                                                &trans  &trans  &trans          &trans    &trans      &trans
            >;
        };

        // F-keys on the left (numpad-mirrored), media on the right.
        //             ┌────┬────┬────┬────┬─────┐        ┌─────┬─────┬────┬────┬────┐
        //             │F12 │F7  │F8  │F9  │PSCR │        │BRI- │BRI+ │    │    │    │
        //             ├────┼────┼────┼────┼─────┤        ├─────┼─────┼────┼────┼────┤
        //             │F11 │F4  │F5  │F6  │    │        │PREV │VOL- │VOL+│NEXT│MUTE│
        //        ┌────┼────┼────┼────┼────┼─────┐        ├─────┼─────┼────┼────┼────┼────┐
        //        │    │F10 │F1  │F2  │F3  │    │        │PP   │RCAP2│    │    │    │    │
        //        └────┴────┴────┴────┼────┼────┼────┐┌───┼─────┼─────┼────┼────┼────┴────┘
        //                           │    │    │    ││    │    │    │
        //                           └────┴────┴─────┘└────┴────┴────┘
        fun_layer {
            display-name = "Fun";
            label = "FUN";

            bindings = <
                &kp F12   &kp F7   &kp F8   &kp F9   &kp PSCRN              &kp C_BRI_DEC    &kp C_BRI_INC   &trans    &trans    &trans
                &kp F11   &kp F4   &kp F5   &kp F6   &trans                 &kp C_PREV       &kp C_VOL_DN   &kp C_VOL_UP  &kp C_NEXT   &kp C_MUTE
                &trans    &kp F10  &kp F1   &kp F2   &kp F3     &trans      &kp C_PP         &region_capture2  &trans   &trans    &trans    &trans
                                                &trans  &trans  &trans      &trans    &trans    &trans
            >;
        };

        // Hold NUM + SYM together: BT / outputs / reset / studio.
        //             ┌─────┬─────┬─────┬─────┬─────┐        ┌──────┬─────┬──────┬────┬────┐
        //             │BT0  │BT1  │BT2  │BT3  │BT4  │        │OUTBLE│OUTUSB│OUTTOG│   │   │
        //             ├─────┼─────┼─────┼─────┼─────┤        ├─────┼─────┼──────┼────┼────┤
        //             │     │     │     │     │BTCLR│        │     │     │      │    │    │
        //        ┌────┼─────┼─────┼─────┼─────┼─────┐        ├─────┼─────┼──────┼────┼────┼────┐
        //        │    │RESET│BOOT │STUDIO│    │    │        │     │     │      │    │    │    │
        //        └────┴─────┴─────┴─────┼─────┼─────┼─────┐┌──┼─────┼─────┼──────┼────┼────┴────┘
        //                              │     │     │     ││   │     │     │
        //                              └─────┴─────┴─────┘└──┴─────┴─────┘
        sys_layer {
            display-name = "Sys";
            label = "SYS";

            bindings = <
                &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4          &out OUT_BLE     &out OUT_USB     &out OUT_TOG     &trans    &trans
                &trans          &trans          &trans          &trans          &bt BT_CLR           &trans           &trans           &trans           &trans    &trans
                &trans          &sys_reset      &bootloader     &studio_unlock  &trans          &trans &trans           &trans           &trans           &trans    &trans    &trans
                                                &trans          &trans          &trans                 &trans           &trans           &trans
            >;
        };
    };
};