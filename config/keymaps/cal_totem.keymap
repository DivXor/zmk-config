/*
 * Variant C — "callum-core" (half-layer mods)
 *
 * Design lineage: Callum Oakley's 34-key Ferris keymap. The NAV and SYM
 * layers exist as *half-layers* on both sides: the left thumb activates the
 * left half of the layer (with its own real home-row mods), the right thumb
 * the right half. The half you are NOT holding stays transparent, so you can
 * always mod keys on the other half without obscuring them.
 *
 *   mod a right-half key (e.g. nav arrows):  hold LEFT half  + press its
 *   mod (left home row) + press the key (right half) — or hold both halves.
 *   Shift+7 (= &): hold both thumbs in one roll + left Shift + 7.
 *
 * Numbers live in the SYM halves (1–5 left, 6–0 right, callum-style two-row
 * entry — this variant deliberately tests that trade-off).
 * FUN = hold both SYM thumbs.  SYS = hold both NAV thumbs.
 * ESC/BSPC: combos (Q+W / J+K, N+M) + BSPC/DEL on the NAVR half.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/totem.h"

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4 RB5
#define KEYS_T LH2 LH1 LH0 RH0 RH1 RH2

#include "../includes/behaviours_homerow_mods.dtsi"
#include "../includes/behaviours_variants.dtsi"

#define BASE 0
#define SYML 1
#define SYMR 2
#define NAVL 3
#define NAVR 4
#define FUN  5
#define SYS  6

#include "../includes/combos_variants.dtsi"

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_fun {
            if-layers = <SYML SYMR>;
            then-layer = <FUN>;
        };
        tri_sys {
            if-layers = <NAVL NAVR>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //             ┌────┬────┬────┬────┬────┐        ┌────┬────┬────┬────┬────┐
        //             │ Q  │ W  │ E  │ R  │ T  │        │ Y  │ U  │ I  │ O  │ P  │
        //             ├────┼────┼────┼────┼────┤        ├────┼────┼────┼────┼────┤
        //             │ A* │ S* │ D* │ F* │ G  │        │ H  │ J* │ K* │ L* │ ;* │
        //        ┌────┼────┼────┼────┼────┼────┐        ├────┼────┼────┼────┼────┼────┐
        //        │TAB │ Z  │ X  │ C  │ V  │ B  │        │ N  │ M  │ ,  │ .  │ /  │'⌘  │
        //        └────┴────┴────┴────┼────┼────┼────┐┌───┼────┼────┼────┼────┼────┴────┘
        //                           │NAVL│SYML│ RET ││SPC │SYMR│NAVR│
        //                           └────┴────┴─────┘└────┴────┴────┘

        base_layer {
            display-name = "Base";
            label = "BASE";

            bindings = <
                &kp Q                 &kp W                &kp E                &kp R               &kp T                        &kp Y       &kp U                &kp I               &kp O                 &kp P
                &hm_shift_l LSHFT A   &hm_l LCTRL S        &hm_l LALT D         &hm_l LGUI F        &kp G                        &kp H       &hm_r RGUI J          &hm_r RALT K        &hm_r RCTRL L         &hm_shift_r RSHFT SEMICOLON
                &kp TAB               &kp Z                &kp X                &kp C               &kp V        &kp B            &kp N       &kp M                &kp COMMA            &kp DOT               &kp SLASH                    &sqt_hyper LC(LS(LA(LGUI))) SQT
                                        &mo NAVL   &mo SYML   &kp RET     &kp SPACE    &mo SYMR   &mo NAVR
            >;
        };

        // Left half of SYM: numbers 1-5 + real mods + ESC (callum keeps ESC
        // on both sym halves). Right half stays transparent (base letters).
        //             ┌────┬────┬────┬────┬────┐        ┌────┬────┬────┬────┬────┐
        //             │ 1  │ 2  │ 3  │ 4  │ 5  │        │    │    │    │    │    │
        //             ├────┼────┼────┼────┼────┤        ├────┼────┼────┼────┼────┤
        //             │⇧   │⌃   │⌥   │⌘   │ESC │        │    │    │    │    │    │
        //        ┌────┼────┼────┼────┼────┼────┐        ├────┼────┼────┼────┼────┼────┐
        //        │    │ `  │ -  │ =  │ [  │ +  │        │    │    │    │    │    │    │
        //        └────┴────┴────┴────┼────┼────┼────┐┌───┼────┼────┼────┼────┼────┴────┘
        //                           │    │    │    ││    │    │    │
        //                           └────┴────┴─────┘└────┴────┴────┘
        syml_layer {
            display-name = "Sym L";
            label = "SYML";

            bindings = <
                &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                &trans    &trans    &trans    &trans    &trans
                &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &kp ESC              &trans    &trans    &trans    &trans    &trans
                &trans    &kp GRAVE &kp MINUS &kp EQUAL &kp LBKT &kp PLUS     &trans    &trans    &trans    &trans    &trans    &trans
                                    &trans  &trans  &trans      &trans    &trans    &trans
            >;
        };

        // Right half of SYM: numbers 6-0 + real mods + ESC. Shift + a digit
        // (left half's shift while holding both) gives shifted symbols (&, %).
        //             ┌────┬────┬────┬────┬────┐        ┌────┬────┬────┬────┬────┐
        //             │    │    │    │    │    │        │ 6  │ 7  │ 8  │ 9  │ 0  │
        //             ├────┼────┼────┼────┼────┤        ├────┼────┼────┼────┼────┤
        //             │    │    │    │    │    │        │ESC │⌘   │⌥   │⌃   │⇧   │
        //        ┌────┼────┼────┼────┼────┼────┐        ├────┼────┼────┼────┼────┼────┐
        //        │    │    │    │    │    │    │        │ ]  │ \  │ |  │ _  │ ~  │    │
        //        └────┴────┴────┴────┼────┼────┼────┐┌───┼────┼────┼────┼────┼────┴────┘
        //                           │    │    │    ││    │    │    │
        //                           └────┴────┴─────┘└────┴────┴────┘
        symr_layer {
            display-name = "Sym R";
            label = "SYMR";

            bindings = <
                &trans    &trans    &trans    &trans    &trans                &kp N6    &kp N7     &kp N8     &kp N9     &kp N0
                &trans    &trans    &trans    &trans    &trans                &kp ESC   &kp RGUI   &kp RALT   &kp RCTRL   &kp RSHFT
                &trans    &trans    &trans    &trans    &trans    &trans      &kp RBKT  &kp BSLH   &kp PIPE   &kp UNDER   &kp TILDE    &trans
                                    &trans  &trans  &trans      &trans    &trans    &trans
            >;
        };

        // Left half of NAV: real mods on the home row only.
        //             ┌────┬────┬────┬────┬────┐        ┌────┬────┬────┬────┬────┐
        //             │    │    │    │    │    │        │    │    │    │    │    │
        //             ├────┼────┼────┼────┼────┤        ├────┼────┼────┼────┼────┤
        //             │⇧   │⌃   │⌥   │⌘   │    │        │    │    │    │    │    │
        //        ┌────┼────┼────┼────┼────┼────┐        ├────┼────┼────┼────┼────┼────┐
        //        │    │    │    │    │    │    │        │    │    │    │    │    │    │
        //        └────┴────┴────┴────┼────┼────┼────┐┌───┼────┼────┼────┼────┼────┴────┘
        //                           │    │    │    ││    │    │    │
        //                           └────┴────┴─────┘└────┴────┴────┘
        navl_layer {
            display-name = "Nav L";
            label = "NAVL";

            bindings = <
                &trans    &trans    &trans    &trans    &trans                &trans    &trans    &trans    &trans    &trans
                &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans              &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans      &trans    &trans    &trans    &trans    &trans    &trans
                                    &trans  &trans  &trans      &trans    &trans    &trans
            >;
        };

        // Right half of NAV: BSPC/DEL/undo/redo + arrows + caps-word.
        //             ┌────┬────┬────┬────┬────┐        ┌─────┬─────┬─────┬─────┬─────┐
        //             │    │    │    │    │    │        │BSPC │ DEL │UNDO │REDO │     │
        //             ├────┼────┼────┼────┼────┤        ├─────┼─────┼─────┼─────┼─────┤
        //             │    │    │    │    │    │        │ ←   │ ↓   │ ↑   │ →   │CAPS │
        //        ┌────┼────┼────┼────┼────┼────┐        ├─────┼─────┼─────┼─────┼─────┼─────┐
        //        │    │    │    │    │    │    │        │ INS │PGDN │PGUP │HOME │END  │     │
        //        └────┴────┴────┴────┼────┼────┼────┐┌───┼─────┼─────┼─────┼─────┴─────┴─────┘
        //                           │    │    │    ││    │     │     │
        //                           └────┴────┴─────┘└────┴─────┴─────┘
        navr_layer {
            display-name = "Nav R";
            label = "NAVR";

            bindings = <
                &trans    &trans    &trans    &trans    &trans                &kp BSPC    &kp DEL     &kp LG(Z)   &kp LS(LG(Z))   &trans
                &trans    &trans    &trans    &trans    &trans                &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT       &caps_word_kebab
                &trans    &trans    &trans    &trans    &trans    &trans      &kp INS     &kp PG_DN   &kp PG_UP   &kp HOME        &kp END     &trans
                                    &trans  &trans  &trans      &trans    &trans    &trans
            >;
        };

        // Hold both SYM thumbs together: F-keys left, media right.
        fun_layer {
            display-name = "Fun";
            label = "FUN";

            bindings = <
                &kp F12   &kp F7   &kp F8   &kp F9   &kp PSCRN              &kp C_BRI_DEC    &kp C_BRI_INC   &trans    &trans    &trans
                &kp F11   &kp F4   &kp F5   &kp F6   &trans                 &kp C_PREV       &kp C_VOL_DN   &kp C_VOL_UP  &kp C_NEXT   &kp C_MUTE
                &trans    &kp F10  &kp F1   &kp F2   &kp F3     &trans      &kp C_PP         &region_capture2  &trans   &trans    &trans    &trans
                                    &trans  &trans  &trans      &trans    &trans    &trans
            >;
        };

        // Hold both NAV thumbs together: BT / outputs / reset / studio.
        sys_layer {
            display-name = "Sys";
            label = "SYS";

            bindings = <
                &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4          &out OUT_BLE     &out OUT_USB     &out OUT_TOG     &trans    &trans
                &trans          &trans          &trans          &trans          &bt BT_CLR           &trans           &trans           &trans           &trans    &trans
                &trans          &sys_reset      &bootloader     &studio_unlock  &trans          &trans &trans           &trans           &trans           &trans    &trans    &trans
                                                &trans          &trans          &trans                 &trans           &trans           &trans
            >;
        };
    };
};