/*
 * Variant B — "seniply-core" (kometa, 42-key grid)
 *
 * Identical scheme to sen_totem.keymap; the kometa's outer column keeps
 * ESC / TAB / BSPC / SQT / DEL as bonus corner keys (this variant relies on
 * combos + the EXT layer for ESC/BSPC on the totem, so the corners here are
 * a comfort upgrade, not a divergence).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
#define KEYS_T LH2 LH1 LH0 RH0 RH1 RH2

#include "../includes/behaviours_homerow_mods.dtsi"
#include "../includes/behaviours_variants.dtsi"

#define BASE 0
#define EXT  1
#define NUM  2
#define SYM  3
#define FUN  4
#define SYS  5

#include "../includes/combos_variants.dtsi"

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <EXT SYM>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            label = "BASE";

            bindings = <
                &kp ESC   &kp Q                &kp W &kp E &kp R &kp T              &kp Y &kp U      &kp I      &kp O     &kp P        &kp BSPC
                &kp TAB   &hm_shift_l LSHFT A &hm_l LCTRL S &hm_l LALT D &hm_l LGUI F &kp G    &kp H &hm_r RGUI J &hm_r RALT K &hm_r RCTRL L &hm_shift_r RSHFT SEMICOLON &kp SQT
                &kp DEL   &kp Z &kp X &kp C &kp V &kp B                         &kp N &kp M  &kp COMMA &kp DOT &kp SLASH &sqt_hyper LC(LS(LA(LGUI))) SQT
                                    &mo EXT   &mo NUM   &kp RET     &kp SPACE    &mo SYM   &mo FUN
            >;
        };

        ext_layer {
            display-name = "Extend";
            label = "EXT";

            // one-shot mods left home row; nav + BSPC/DEL/INS right
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans                    &kp PG_UP   &kp BSPC      &kp DEL     &kp INS     &trans      &trans
                &trans  &sk LSHFT  &sk LCTRL  &sk LALT  &sk LGUI  &sk LC(LS(LA(LGUI)))  &kp LEFT     &kp DOWN      &kp UP      &kp RIGHT   &caps_word_kebab &trans
                &trans  &trans  &trans  &trans  &trans  &trans                    &trans      &kp HOME      &kp END     &trans      &trans      &trans
                                    &trans  &trans  &trans                          &trans    &trans      &trans
            >;
        };

        num_layer {
            display-name = "Num";
            label = "NUM";

            // numpad right (left thumb holds), one-shot mods left home row
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans                    &kp MINUS   &kp N7      &kp N8      &kp N9      &kp SLASH   &trans
                &trans  &sk LSHFT  &sk LCTRL  &sk LALT  &sk LGUI  &sk LC(LS(LA(LGUI)))  &kp PLUS    &kp N4      &kp N5      &kp N6      &kp ASTRK   &trans
                &trans  &trans  &trans  &trans  &trans  &trans                    &kp DOT     &kp N1      &kp N2      &kp N3      &kp N0      &kp EQUAL
                                    &trans  &trans  &trans                          &trans    &trans      &trans
            >;
        };

        sym_layer {
            display-name = "Sym";
            label = "SYM";

            // symbols left (frequent _ ( ) = : on home), one-shot mods right
            bindings = <
                &trans  &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT              &kp CARET   &kp AMPS    &kp ASTRK   &kp BSLH    &kp PIPE    &trans
                &trans  &kp UNDER  &kp LPAR   &kp RPAR   &kp EQUAL  &kp COLON              &trans      &sk RGUI    &sk RALT    &sk RCTRL   &sk RSHFT   &trans
                &trans  &kp LBKT   &kp RBKT   &kp LBRC   &kp RBRC   &kp MINUS    &kp GRAVE   &kp TILDE   &trans      &trans      &trans      &trans
                                    &trans  &trans  &trans                          &trans    &trans      &trans
            >;
        };

        fun_layer {
            display-name = "Fun";
            label = "FUN";

            // F-keys left, media right
            bindings = <
                &trans  &kp F12   &kp F7   &kp F8   &kp F9   &kp PSCRN            &kp C_BRI_DEC   &kp C_BRI_INC  &trans   &trans    &trans    &trans
                &trans  &kp F11   &kp F4   &kp F5   &kp F6   &trans               &kp C_PREV      &kp C_VOL_DN   &kp C_VOL_UP  &kp C_NEXT   &kp C_MUTE   &trans
                &trans  &kp F10  &kp F1   &kp F2   &kp F3   &trans              &kp C_PP        &region_capture2  &trans   &trans    &trans    &trans
                                    &trans  &trans  &trans                          &trans    &trans      &trans
            >;
        };

        sys_layer {
            display-name = "Sys";
            label = "SYS";

            // hold EXT + SYM together: BT / outputs / reset / studio
            bindings = <
                &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4          &out OUT_BLE    &out OUT_USB    &out OUT_TOG    &trans  &trans  &trans
                &trans  &trans        &trans        &trans        &trans        &bt BT_CLR           &trans          &trans          &trans          &trans  &trans  &trans
                &trans  &sys_reset    &bootloader   &studio_unlock &trans &trans     &trans          &trans          &trans          &trans  &trans  &trans
                                    &trans  &trans  &trans                          &trans          &trans          &trans
            >;
        };
    };
};